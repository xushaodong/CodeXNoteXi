<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/writingRoot"
    android:layout_width="match_parent"
    android:background="#00ffff"
    android:layout_height="match_parent">

    <!-- 1. 背景层：动态雨夜 -->
    <com.xi.app.ui.view.RainyGlassView
        android:id="@+id/dynamicBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:clickable="false" />

    <!-- 2. UI层：使用独立容器确保在背景之上 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_minimal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBarSpacer"
            app:tint="#CBD5E1" />

        <ImageButton
            android:id="@+id/moreButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="更多选项"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBarSpacer"
            app:tint="#CBD5E1" />

        <TextView
            android:id="@+id/promptIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="64dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBarSpacer" />

        <!-- 输入区域：确保 match_parent 级别的高度以响应点击 -->
        <EditText
            android:id="@+id/writingInput"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="@android:color/transparent"
            android:fontFamily="serif"
            android:gravity="top|start"
            android:hint="此刻，雨声是唯一的听众..."
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingExtra="14dp"
            android:padding="4dp"
            android:textColor="@color/xi_flow_text"
            android:textColorHint="@color/xi_flow_hint"
            android:textCursorDrawable="@null"
            android:textSize="19sp"
            app:layout_constraintBottom_toTopOf="@+id/actionPanel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/promptIndicator" />

        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/wordHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="serif"
                android:text="思想在流淌，不要停下来"
                android:textColor="#475569"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/freezeButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="定格瞬间"
                android:textColor="@color/xi_amber"
                android:textSize="15sp"
                app:rippleColor="#20D97706" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
