<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Xi" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/xi_amber</item>
        <item name="colorOnPrimary">@color/xi_text_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/xi_bg_dark</item>
    </style>

    <style name="Theme.Xi.Fullscreen" parent="Theme.Xi">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
