<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. 基础深蓝雨夜渐变 -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#0F172A"
                android:centerColor="#1E293B"
                android:endColor="#020617"
                android:type="linear" />
        </shape>
    </item>

    <!-- 2. 模拟毛玻璃的朦胧感（微弱的浅色浮层） -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#10FFFFFF"
                android:endColor="#05FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- 3. 模拟雨水划过玻璃的纵向质感 -->
    <item>
        <bitmap
            android:src="@android:drawable/screen_background_dark_transparent"
            android:tileMode="repeat"
            android:alpha="0.05" />
    </item>
</layer-list>
